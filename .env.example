# Sao chép file này thành .env rồi điền giá trị thật (.env KHÔNG được commit lên git)
PORT=3000

# Tài khoản gửi email (Gmail: dùng "Mật khẩu ứng dụng" - App Password)
SMTP_SERVICE=gmail
SMTP_USER=email-cua-ban@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=Bizmate Software

# Tài khoản Quản trị hệ thống (đăng nhập ở trang chủ: ô MST = SUPERADMIN_MST)
# Nên dùng SUPERADMIN_PASSWORD_HASH (bản mã hóa bcrypt) thay cho mật khẩu chữ thường. Tạo hash bằng lệnh:
#   node -e "console.log(require('bcrypt').hashSync('MatKhauCuaBan', 10))"
# Để trống cả hai thì đăng nhập Quản trị hệ thống bị TẮT.
SUPERADMIN_MST=admin
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD_HASH=
# SUPERADMIN_PASSWORD=doi-mat-khau-nay
